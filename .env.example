# Copy this file to .env and fill in what you have. Every value below has a
# safe default if you leave it blank, so the app always runs — you're only
# turning features from "mock" to "real" one at a time as you fill these in.

# Without this, AI classification and policy briefs run in an offline mock
# mode (clearly labeled as such in every response) instead of calling Gemini.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional — pins a specific Gemini model instead of the floating "latest"
# alias. Leave blank unless you have a reason to pin a version.
GEMINI_MODEL=gemini-flash-latest

# Without this, data is stored in a local SQLite file (setu.db) instead of a
# real database. Fine for local testing; see CLOUD_DATABASE_SETUP.txt or
# FREE_HOSTING_SETUP.txt for how to get a real Postgres connection string.
DATABASE_URL=

# Admin (Policymaker portal) login. CHANGE THESE before deploying anywhere
# public — these defaults are only for local testing.
ADMIN_ID=admin
ADMIN_PASSWORD=setu@123

# Optional — the port the app listens on. Most hosting platforms (Render,
# Cloud Run) set this automatically; only set it yourself for local testing
# on a non-default port.
PORT=8000
